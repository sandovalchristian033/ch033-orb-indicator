vwapColorP = input.color(color.new(#4dd0e1, 60), '', inline = 'NYP', group = groupVwap)
vwapStyleP = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'NYP', group = groupVwap, display = display)
groupVwapD = '📈 VWAPs del día'
vwapShowD = input.bool(false, 'VWAP desde el inicio del día', inline = 'B1S', group = groupVwapD)
vwapSourceD = vwapSource
vwapColorD = input.color(#000000, '', inline = 'B1S', group = groupVwapD)
vwapStyleD = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'B1S', group = groupVwapD, display = display)
vwapBand1D  = input.bool(false,"Bandas", inline = 'BS', group = groupVwapD)
